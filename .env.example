NEXT_PUBLIC_BACKEND_SERVER_URL=http://localhost:8000/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:8000

# Server-only values. Never prefix these with NEXT_PUBLIC_.
# Optional backend override; falls back to NEXT_PUBLIC_BACKEND_SERVER_URL.
BACKEND_SERVER_URL=http://localhost:8000/graphql
STALWART_JMAP_URL=https://api.omnixys.com/mail/jmap
MAIL_TOKEN_URL=https://api.omnixys.com/v1/mail/token
OMNIMAIL_SERVICE_TOKEN=replace-with-service-token
# Tenant identifier for multi-tenant environments
NEXT_PUBLIC_OMNIXYS_TENANT_ID=default
OMNIXYS_TENANT_ID=default
# Anonymous admin (service) access used by the admin/BFF layer.
# These are server-only secrets and must be set in production/deployment secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-admin-password
ANALYTICS_CONSENT_SECRET=replace-with-consent-secret
